{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alderwick.example/schemas/urgent-home-repair-application.json",
  "title": "Urgent home-repair grant application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_postcode",
    "tenure",
    "financial_route",
    "repair_type",
    "repair_description",
    "problem_started",
    "estimated_cost",
    "evidence_route",
    "declaration_accuracy"
  ],
  "allOf": [
    { "if": { "properties": { "tenure": { "const": "owner_occupier" } }, "required": ["tenure"] }, "then": { "required": ["ownership_type", "ownership_evidence"] } },
    { "if": { "properties": { "ownership_type": { "const": "joint" } }, "required": ["ownership_type"] }, "then": { "required": ["joint_owner_consent"] } },
    { "if": { "properties": { "ownership_type": { "const": "leasehold" } }, "required": ["ownership_type"] }, "then": { "required": ["freeholder_permission"] } },

    { "if": { "properties": { "financial_route": { "const": "qualifying_benefit" } }, "required": ["financial_route"] }, "then": { "required": ["benefit_type"] } },
    { "if": { "properties": { "financial_route": { "const": "income_under_25000" } }, "required": ["financial_route"] }, "then": { "required": ["annual_income", "income_evidence"] } },
    { "if": { "properties": { "financial_route": { "enum": ["qualifying_benefit", "income_under_25000"] } }, "required": ["financial_route"] }, "then": { "required": ["savings_band"] } },
    { "if": { "properties": { "financial_route": { "const": "not_sure" } }, "required": ["financial_route"] }, "then": { "required": ["finance_help_needed"] } },

    { "if": { "properties": { "repair_type": { "const": "heating" } }, "required": ["repair_type"] }, "then": { "required": ["heating_status", "temporary_heating"] } },
    { "if": { "properties": { "repair_type": { "const": "electrics" } }, "required": ["repair_type"] }, "then": { "required": ["electrical_risk", "power_isolated", "affected_circuits"] } },
    { "if": { "properties": { "repair_type": { "const": "structure" } }, "required": ["repair_type"] }, "then": { "required": ["structural_risk", "affected_structure", "temporary_support"] } },
    { "if": { "properties": { "repair_type": { "const": "water_ingress" } }, "required": ["repair_type"] }, "then": { "required": ["water_source", "water_stopped", "rooms_affected"] } },
    { "if": { "properties": { "repair_type": { "const": "other" } }, "required": ["repair_type"] }, "then": { "required": ["other_urgency", "temporary_measures"] } },

    { "if": { "properties": { "evidence_route": { "enum": ["written_estimate", "both"] } }, "required": ["evidence_route"] }, "then": { "required": ["contractor_name"] } },
    { "if": { "properties": { "evidence_route": { "enum": ["photographs", "both"] } }, "required": ["evidence_route"] }, "then": { "required": ["photo_status"] } },
    { "if": { "properties": { "evidence_route": { "const": "none" } }, "required": ["evidence_route"] }, "then": { "required": ["evidence_help_needed"] } }
  ],
  "properties": {
    "property_postcode": {
      "type": "string",
      "title": "What is the property postcode?",
      "description": "The property must be in the fictional Alderwick area (AW1 to AW4).",
      "pattern": "^AW[1-4] [0-9][A-Z]{2}$",
      "x-shortLabel": "Property postcode",
      "x-input": "text",
      "x-requirementId": "REQ-AREA",
      "x-agentWritable": true
    },
    "tenure": {
      "type": "string",
      "title": "What is your housing situation?",
      "description": "The answer decides which ownership questions and support rules apply.",
      "oneOf": [
        { "const": "owner_occupier", "title": "I own the property and live there" },
        { "const": "private_tenant", "title": "I rent from a private landlord" },
        { "const": "social_tenant", "title": "I rent from the council or a housing association" },
        { "const": "landlord", "title": "I own the property but do not live there" }
      ],
      "x-shortLabel": "Housing situation",
      "x-input": "radio",
      "x-requirementId": "REQ-HOME",
      "x-agentWritable": true
    },
    "ownership_type": {
      "type": "string",
      "title": "How do you own the property?",
      "description": "Some ownership arrangements need one extra permission check.",
      "oneOf": [
        { "const": "sole", "title": "I am the sole freehold owner" },
        { "const": "joint", "title": "I own it jointly with someone else" },
        { "const": "leasehold", "title": "I own the leasehold" }
      ],
      "x-shortLabel": "Ownership type",
      "x-input": "radio",
      "x-requirementId": "REQ-HOME",
      "x-agentWritable": true
    },
    "joint_owner_consent": {
      "type": "string",
      "title": "Have the other owners agreed to this application?",
      "description": "Every registered owner would need to agree before a real grant could proceed.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "not_yet", "title": "Not yet" }
      ],
      "x-shortLabel": "Joint-owner agreement",
      "x-input": "radio",
      "x-requirementId": "REQ-HOME",
      "x-agentWritable": true
    },
    "freeholder_permission": {
      "type": "string",
      "title": "Does the lease require the freeholder’s permission?",
      "description": "Check the lease before answering. No document is uploaded in this prototype.",
      "oneOf": [
        { "const": "not_required", "title": "No permission is required" },
        { "const": "ready", "title": "Yes, and permission is ready" },
        { "const": "not_ready", "title": "Yes, but permission is not ready" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Freeholder permission",
      "x-input": "radio",
      "x-requirementId": "REQ-HOME",
      "x-agentWritable": true
    },
    "ownership_evidence": {
      "type": "string",
      "title": "Do you have evidence that you own the property?",
      "description": "A mortgage statement, title record or lease would be accepted in a real service.",
      "oneOf": [
        { "const": "ready", "title": "Yes" },
        { "const": "need_help", "title": "No, I need help finding it" }
      ],
      "x-shortLabel": "Ownership evidence",
      "x-input": "radio",
      "x-requirementId": "REQ-EVIDENCE",
      "x-agentWritable": true
    },

    "financial_route": {
      "type": "string",
      "title": "Which financial condition applies to your household?",
      "description": "You only need to complete the questions for one financial route.",
      "oneOf": [
        { "const": "qualifying_benefit", "title": "Someone receives a qualifying income-related benefit" },
        { "const": "income_under_25000", "title": "Annual household income is below £25,000" },
        { "const": "neither", "title": "Neither applies" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Financial route",
      "x-input": "radio",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },
    "benefit_type": {
      "type": "string",
      "title": "Which qualifying benefit is received?",
      "description": "Choose the main benefit used for this application.",
      "oneOf": [
        { "const": "universal_credit", "title": "Universal Credit" },
        { "const": "pension_credit", "title": "Pension Credit" },
        { "const": "income_support", "title": "Income Support" },
        { "const": "income_based_jsa", "title": "Income-based Jobseeker’s Allowance" },
        { "const": "income_related_esa", "title": "Income-related Employment and Support Allowance" },
        { "const": "housing_benefit", "title": "Housing Benefit" }
      ],
      "x-shortLabel": "Qualifying benefit",
      "x-input": "select",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },
    "annual_income": {
      "type": "integer",
      "title": "What is the household’s annual income before tax?",
      "description": "Enter a whole-pound amount for everyone who normally lives in the home.",
      "minimum": 0,
      "maximum": 24999,
      "x-shortLabel": "Annual household income",
      "x-input": "currency",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },
    "savings_band": {
      "type": "string",
      "title": "How much does the household have in savings?",
      "description": "Include savings and investments, but not the home you live in.",
      "oneOf": [
        { "const": "under_6000", "title": "Less than £6,000" },
        { "const": "6000_to_15999", "title": "£6,000 to £15,999" },
        { "const": "16000_or_more", "title": "£16,000 or more" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Household savings",
      "x-input": "radio",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },
    "income_evidence": {
      "type": "string",
      "title": "Can you provide evidence of the household income?",
      "description": "Recent payslips, pension statements or accounts would be accepted in a real service.",
      "oneOf": [
        { "const": "ready", "title": "Yes" },
        { "const": "need_help", "title": "No, I need help gathering it" }
      ],
      "x-shortLabel": "Income evidence",
      "x-input": "radio",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },
    "finance_help_needed": {
      "type": "string",
      "title": "What do you need help checking?",
      "description": "Choose the uncertainty that prevents you selecting a financial route.",
      "oneOf": [
        { "const": "benefits", "title": "Whether a benefit qualifies" },
        { "const": "income", "title": "How to calculate household income" },
        { "const": "both", "title": "Both" }
      ],
      "x-shortLabel": "Financial help needed",
      "x-input": "radio",
      "x-requirementId": "REQ-INCOME",
      "x-agentWritable": true
    },

    "repair_type": {
      "type": "string",
      "title": "What is the main repair?",
      "description": "The answer selects the safety and evidence questions for that kind of problem.",
      "oneOf": [
        { "const": "heating", "title": "Heating or hot water" },
        { "const": "electrics", "title": "Electrical system" },
        { "const": "structure", "title": "Walls, roof or structure" },
        { "const": "water_ingress", "title": "Water entering the home" },
        { "const": "other", "title": "Another urgent repair" }
      ],
      "x-shortLabel": "Repair type",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "repair_description": {
      "type": "string",
      "title": "Describe what has happened",
      "description": "Say what stopped working or became unsafe, when it began, and which rooms are affected. Do not include medical details.",
      "minLength": 30,
      "maxLength": 500,
      "x-shortLabel": "Repair description",
      "x-input": "textarea",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "problem_started": {
      "type": "string",
      "title": "When did the problem begin?",
      "description": "An approximate period is enough for this prototype.",
      "oneOf": [
        { "const": "today", "title": "Today" },
        { "const": "last_3_days", "title": "Within the last 3 days" },
        { "const": "last_2_weeks", "title": "Within the last 2 weeks" },
        { "const": "over_2_weeks", "title": "More than 2 weeks ago" }
      ],
      "x-shortLabel": "Problem started",
      "x-input": "radio",
      "x-agentWritable": true
    },
    "heating_status": {
      "type": "string",
      "title": "What heating or hot water is available now?",
      "description": "This question only applies to heating and hot-water repairs.",
      "oneOf": [
        { "const": "none", "title": "No main heating or hot water" },
        { "const": "partial", "title": "Some heating or hot water remains" },
        { "const": "working", "title": "Both are still working" }
      ],
      "x-shortLabel": "Heating status",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "temporary_heating": {
      "type": "string",
      "title": "Do you have a safe temporary source of heat?",
      "description": "For example, a safe portable heater that is already available.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_needed", "title": "Not needed" }
      ],
      "x-shortLabel": "Temporary heating",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "electrical_risk": {
      "type": "string",
      "title": "Is there an immediate electrical warning sign?",
      "description": "Examples include sparks, burning smells, repeated tripping or exposed live parts.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Electrical warning sign",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "power_isolated": {
      "type": "string",
      "title": "Has the affected circuit or supply been switched off?",
      "description": "Do not approach unsafe electrics to check. Answer only from what you already know.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Power isolated",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "affected_circuits": {
      "type": "string",
      "title": "How much of the electrical system is affected?",
      "description": "Choose the closest description without inspecting anything unsafe.",
      "oneOf": [
        { "const": "one_area", "title": "One room or circuit" },
        { "const": "several_areas", "title": "Several rooms or circuits" },
        { "const": "whole_home", "title": "The whole home" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Electrical area affected",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "structural_risk": {
      "type": "string",
      "title": "Is any part of the home unsafe to use?",
      "description": "This question only applies to structural repairs.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Structural safety",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "affected_structure": {
      "type": "string",
      "title": "Which part of the building is affected?",
      "description": "Choose the closest category.",
      "oneOf": [
        { "const": "roof", "title": "Roof or chimney" },
        { "const": "wall", "title": "Wall" },
        { "const": "floor_or_stairs", "title": "Floor or stairs" },
        { "const": "other", "title": "Another structural part" }
      ],
      "x-shortLabel": "Structure affected",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "temporary_support": {
      "type": "string",
      "title": "Has a professional installed temporary support?",
      "description": "Do not attempt structural support yourself.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Temporary structural support",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "water_source": {
      "type": "string",
      "title": "Where is the water coming from?",
      "description": "Choose the closest known source.",
      "oneOf": [
        { "const": "roof_or_wall", "title": "Roof, wall or external opening" },
        { "const": "pipe_or_appliance", "title": "Pipe or appliance" },
        { "const": "ground_or_drain", "title": "Ground or drain" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Water source",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "water_stopped": {
      "type": "string",
      "title": "Has the flow of water stopped?",
      "description": "Do not take risks to find or stop the source.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_sure", "title": "I am not sure" }
      ],
      "x-shortLabel": "Water stopped",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "rooms_affected": {
      "type": "integer",
      "title": "How many rooms are affected?",
      "description": "Enter the number of rooms that cannot be used normally.",
      "minimum": 1,
      "maximum": 20,
      "x-shortLabel": "Rooms affected",
      "x-input": "number",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "other_urgency": {
      "type": "string",
      "title": "What makes this other repair urgent?",
      "description": "Choose the main current effect.",
      "oneOf": [
        { "const": "essential_service", "title": "An essential service is unavailable" },
        { "const": "safety_risk", "title": "There is an immediate safety risk" },
        { "const": "important_room", "title": "An important room cannot be used" },
        { "const": "none", "title": "None of these" }
      ],
      "x-shortLabel": "Reason the repair is urgent",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },
    "temporary_measures": {
      "type": "string",
      "title": "Have you taken any temporary safety measures?",
      "description": "Describe only safe steps that have already been taken.",
      "oneOf": [
        { "const": "yes", "title": "Yes" },
        { "const": "no", "title": "No" },
        { "const": "not_applicable", "title": "Not applicable" }
      ],
      "x-shortLabel": "Temporary measures",
      "x-input": "radio",
      "x-requirementId": "REQ-URGENT",
      "x-agentWritable": true
    },

    "estimated_cost": {
      "type": "integer",
      "title": "What is the expected repair cost?",
      "description": "Enter a whole amount from £250 to £7,500, including tax.",
      "minimum": 250,
      "maximum": 7500,
      "x-shortLabel": "Expected cost",
      "x-input": "currency",
      "x-requirementId": "REQ-COST",
      "x-agentWritable": true
    },
    "evidence_route": {
      "type": "string",
      "title": "What evidence of the repair is available?",
      "description": "A real application would need a written estimate, clear photographs, or both.",
      "oneOf": [
        { "const": "written_estimate", "title": "A written contractor estimate" },
        { "const": "photographs", "title": "Clear photographs" },
        { "const": "both", "title": "A written estimate and photographs" },
        { "const": "none", "title": "Neither is ready" }
      ],
      "x-shortLabel": "Repair evidence",
      "x-input": "radio",
      "x-requirementId": "REQ-EVIDENCE",
      "x-agentWritable": true
    },
    "contractor_name": {
      "type": "string",
      "title": "What is the contractor or company name?",
      "description": "Enter the name shown on the written estimate.",
      "minLength": 2,
      "maxLength": 100,
      "x-shortLabel": "Contractor",
      "x-input": "text",
      "x-requirementId": "REQ-EVIDENCE",
      "x-agentWritable": true
    },
    "photo_status": {
      "type": "string",
      "title": "Were the photographs taken safely?",
      "description": "Do not enter unsafe areas or approach exposed wiring to take photographs.",
      "oneOf": [
        { "const": "safe", "title": "Yes" },
        { "const": "not_safe", "title": "No, taking them would be unsafe" }
      ],
      "x-shortLabel": "Photograph safety",
      "x-input": "radio",
      "x-requirementId": "REQ-EVIDENCE",
      "x-agentWritable": true
    },
    "evidence_help_needed": {
      "type": "string",
      "title": "Which evidence do you need help obtaining?",
      "description": "The council could explain the accepted evidence before you continue.",
      "oneOf": [
        { "const": "estimate", "title": "A written contractor estimate" },
        { "const": "photographs", "title": "Safe photographs" },
        { "const": "both", "title": "Both" }
      ],
      "x-shortLabel": "Evidence help needed",
      "x-input": "radio",
      "x-requirementId": "REQ-EVIDENCE",
      "x-agentWritable": true
    },
    "declaration_accuracy": {
      "type": "string",
      "title": "I confirm that the answers are accurate to the best of my knowledge",
      "description": "Only the applicant can make this declaration. An agent cannot propose or confirm it.",
      "oneOf": [{ "const": "yes", "title": "I confirm" }],
      "x-shortLabel": "Applicant declaration",
      "x-input": "checkbox",
      "x-requirementId": "REQ-DECLARATION",
      "x-agentWritable": false
    }
  }
}
